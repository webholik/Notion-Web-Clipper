{
  "name": "pocket-clipper-for-notion",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts tests/*.test.mjs",
    "test:browser": "playwright test",
    "lint": "web-ext lint --source-dir dist --no-config-discovery",
    "package": "npm run build && node scripts/package.mjs",
    "check": "npm run format:check && npm run check:code",
    "dev": "npm run build && web-ext run --source-dir dist --firefox firefox",
    "preview": "npm run build && node scripts/preview.mjs",
    "test:firefox": "npm run build && node scripts/test-firefox.mjs",
    "demo": "npm run build && node scripts/preview.mjs --demo --port=4174",
    "format": "prettier --write .",
    "format:check": "prettier --check . && node scripts/check-style.mjs",
    "check:code": "npm run typecheck && npm test && npm run build && npm run lint"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0"
  },
  "devDependencies": {
    "@babel/parser": "^8.0.7",
    "@playwright/test": "^1.64.1",
    "@types/firefox-webext-browser": "^143.0.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "web-ext": "^10.8.0"
  }
}
